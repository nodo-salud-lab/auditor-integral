name: Clasificar issues

on:
  issues:
    types: [opened]

jobs:
  etiquetar:
    runs-on: ubuntu-latest
    permissions:
      issues: write
    steps:
      - name: Registrar título
        run: |
          echo "Nuevo issue: ${{ github.event.issue.title }}"
          gh issue edit ${{ github.event.issue.number }} --add-label "por-revisar"
        env:
          GH_TOKEN: ${{ github.token }}
