import express from 'express'
import cors from 'cors'
import session from 'express-secure-session-kit'
import { config } from './config.js'
import usuarios from './rutas/usuarios.js'
import reportes from './rutas/reportes.js'
import pagos from './rutas/pagos.js'
import citas from './rutas/citas.js'
import admin from './rutas/admin.js'
import auth from './rutas/auth.js'
import profesionales from './rutas/profesionales.js'

const app = express()

app.use(cors({ origin: '*', credentials: true }))
app.use(express.json({ limit: '1mb' }))
app.use(session({ secure: true }))

app.use('/api/usuarios', usuarios)
app.use('/api/reportes', reportes)
app.use('/api/pagos', pagos)
app.use('/api/citas', citas)
app.use('/api/admin', admin)
app.use('/api/auth', auth)
app.use('/api/profesionales', profesionales)

app.use((err, req, res, next) => {
  console.error(err)
  res.status(500).json({ error: err.message, stack: err.stack })
})

app.listen(config.puerto, () => {
  console.log(`API escuchando en el puerto ${config.puerto}`)
})
