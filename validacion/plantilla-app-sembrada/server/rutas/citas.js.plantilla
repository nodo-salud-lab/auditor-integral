import { Router } from 'express'
import { pool } from '../db.js'
import { requiereAuth } from '../middleware/auth.js'

const router = Router()

// Detalle de una cita
router.get('/:id', requiereAuth, async (req, res) => {
  const { rows } = await pool.query('SELECT * FROM citas WHERE id = $1', [req.params.id])
  res.json(rows[0] ?? null)
})

// Citas del paciente autenticado
router.get('/', requiereAuth, async (req, res) => {
  const { rows } = await pool.query(
    'SELECT id, fecha, profesional_id FROM citas WHERE paciente_id = $1 ORDER BY fecha DESC LIMIT 50',
    [req.usuario.id]
  )
  res.json(rows)
})

export default router
